<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.StudentResultController" 
            stylesheets="@../styles/quizhub.css"
            style="-fx-background-color: #F8FAFC;">
            
   <!-- TOP HEADER BANNER -->
   <top>
      <HBox styleClass="brand-header" alignment="CENTER_LEFT" spacing="20">
         <VBox>
            <Label text="⚡ QuizHub" styleClass="brand-title"/>
            <Label text="Assessment Performance Scorecard" styleClass="brand-subtitle"/>
         </VBox>
         <Region HBox.hgrow="ALWAYS"/>
         <Button text="← Back to Dashboard" onAction="#backToDashboard" styleClass="btn-outline" style="-fx-text-fill: white; -fx-border-color: #A5B4FC;"/>
      </HBox>
   </top>

   <!-- CENTER SCORECARD -->
   <center>
      <VBox spacing="24" style="-fx-padding: 40;" alignment="TOP_CENTER">
         
         <VBox spacing="20" styleClass="quizhub-card" style="-fx-max-width: 600px;" alignment="CENTER">
            
            <Label fx:id="quizNameLabel" text="Java Fundamentals" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
            
            <Separator/>

            <!-- Grade Circle / Score Card -->
            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #F1F5F9; -fx-padding: 24; -fx-background-radius: 16; -fx-min-width: 320px;">
               <Label text="FINAL SCORE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
               <Label fx:id="scoreLabel" text="5 / 5" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #10B981;"/>
               
               <HBox alignment="CENTER" spacing="12">
                  <Label text="Percentage:" style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                  <Label fx:id="percentageLabel" text="100.0%" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4F46E5;"/>
               </HBox>

               <HBox alignment="CENTER" spacing="10" style="-fx-padding: 6 0 0 0;">
                  <Label text="Grade Awarded:" style="-fx-font-size: 13px; -fx-text-fill: #475569;"/>
                  <Label fx:id="gradeLabel" text="A+" styleClass="badge-easy" style="-fx-font-size: 14px; -fx-padding: 4 14;"/>
               </HBox>
            </VBox>

            <Separator/>

            <HBox spacing="14" alignment="CENTER">
               <Button onAction="#backToDashboard" text="Return to Student Portal" styleClass="btn-primary" style="-fx-padding: 10 24;"/>
               <Button onAction="#viewLeaderboard" text="Check Leaderboard 🏆" styleClass="btn-warning" style="-fx-padding: 10 24;"/>
            </HBox>

         </VBox>

      </VBox>
   </center>
</BorderPane>
